{
  "name": "adoptme-final-backend",
  "version": "1.0.0",
  "description": "Entrega final Backend III: tests funcionales de adopciones, Docker, Swagger y CI/CD.",
  "type": "module",
  "main": "src/server.js",
  "private": false,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "smoke:core": "node scripts/smoke-core.js",
    "test": "cross-env NODE_ENV=test mocha \"test/**/*.test.js\" --timeout 10000 --reporter spec",
    "test:functional": "cross-env NODE_ENV=test mocha \"test/functional/**/*.test.js\" --timeout 10000 --reporter spec",
    "test:coverage": "cross-env NODE_ENV=test c8 --clean --all --check-coverage --lines 95 --functions 95 --branches 90 --statements 95 --include=src/app.js --include=src/controllers/** --include=src/docs/** --include=src/middlewares/** --include=src/routes/** --include=src/services/** --include=src/utils/** npm test",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:coverage && npm run smoke:core",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=10.9.0"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "docker",
    "testing",
    "swagger",
    "coderhouse"
  ],
  "author": "Diego Portal",
  "license": "MIT",
  "dependencies": {
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "mongoose": "9.7.4",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "chai": "6.2.2",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "globals": "17.8.0",
    "mocha": "11.7.6",
    "sinon": "22.0.0",
    "supertest": "7.2.2",
    "@eslint/js": "9.39.2"
  }
}
